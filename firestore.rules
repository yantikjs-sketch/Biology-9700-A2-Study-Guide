rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'accountType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'accountType', 'classCode', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.email == request.auth.token.email
        && data.accountType is string
        && data.accountType in ['student', 'teacher']
        && (!('classCode' in data) || (data.classCode is string && data.classCode.size() <= 32 && data.classCode.matches('^[a-zA-Z0-9_\\- ]*$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizProgress(data) {
      return data.keys().hasAll(['ownerId', 'answers', 'totalAnswered', 'totalCorrect', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'answers', 'totalAnswered', 'totalCorrect', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.answers is map
        && data.answers.size() <= 200
        && data.totalAnswered is int
        && data.totalAnswered >= 0
        && data.totalAnswered <= 200
        && data.totalCorrect is int
        && data.totalCorrect >= 0
        && data.totalCorrect <= 200
        && data.totalCorrect <= data.totalAnswered
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidParentProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isVerifiedEmail() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().accountType == existing().accountType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'classCode', 'updatedAt']);
      allow delete: if false;

      match /progress/{progressId} {
        allow get: if isVerifiedEmail()
          && isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && hasValidParentProfile(userId);
        allow list: if isVerifiedEmail()
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedEmail()
          && isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidQuizProgress(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isVerifiedEmail()
          && isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidQuizProgress(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['answers', 'totalAnswered', 'totalCorrect', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isVerifiedEmail()
          && isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && hasValidParentProfile(userId);
      }
    }
  }
}
